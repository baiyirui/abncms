{
  "name": "abncms",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "description": "ABNcms — a lightweight open-source CMS for Cloudflare Workers + D1 + external image host, designed to run entirely on the free tier",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup:remote": "python scripts/setup_remote.py",
    "smoke": "python scripts/smoke_test.py http://127.0.0.1:8787",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute cf-press-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute cf-press-db --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute cf-press-db --remote --file=./seed.sql",
    "db:migrate": "python scripts/migrate.py"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.152.0"
  }
}
