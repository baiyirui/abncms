{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ─────────────────────────────────────────────────────────────────────────
  // 配置模板：复制为 wrangler.jsonc 后再填写真实 ID。
  //   cp wrangler.example.jsonc wrangler.jsonc
  // wrangler.jsonc 已被 .gitignore 忽略，因为它含你的账号与资源 ID。
  // 也可以直接跑 `python scripts/setup_remote.py`，脚本会自动创建远程资源
  // 并把返回的 ID 写回 wrangler.jsonc。
  // ─────────────────────────────────────────────────────────────────────────
  "name": "abncms",
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-11",

  // 静态资源（CSS / JS / SVG）由 Cloudflare 边缘直接分发
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // D1：文章 / 分类 / 标签 / 用户 / 评论 / 设置 / 访问统计
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-press-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],

  // KV：登录会话 / 页面缓存 / 站点设置缓存 / 登录失败限流
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],

  "ai": { "binding": "AI" },

  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "cf-press-posts"
    }
  ],

  // 说明：图片上传走外部图床（Worker 服务端代理），不需要 R2 绑定。
  // 若历史数据里仍有 R2 key，可额外添加 r2_buckets，/media/* 会自动读取。

  "vars": {
    "SITE_NAME": "ABNcms",
    "SITE_DESCRIPTION": "A lightweight CMS on the Cloudflare free tier",
    "SITE_URL": "https://your-worker.your-subdomain.workers.dev",
    // Cloudflare 官方测试密钥（始终通过）。启用真实验证时必须把 Site Key
    // 与后台设置页的 Turnstile Secret 成对替换为同一 widget 的真实密钥。
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "AI_SUMMARY_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "AI_EMBED_MODEL": "@cf/baai/bge-m3",
    "AI_EMBED_DIMS": "1024",
    "ENABLE_AI": "true",
    "ENABLE_VECTORIZE": "true",
    // 图床也可在「后台 → 设置 → 图床接入」里配置，优先级高于这里的变量。
    // 后台写入的 Token 会经 AES-GCM 加密存 D1，需要主密钥 Secret：
    //   npx wrangler secret put CONFIG_ENCRYPTION_KEY
    // 这是 Secret，不要写进 vars / 不要提交；未配置时后台为「仅环境变量模式」。
    "IMGBED_BASE_URL": "https://your-image-host.example.com",
    "IMGBED_TOKEN_NAME": "your-token-name"
  },

  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
